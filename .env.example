# ---------------------------------------------------------------
# Gulzor — environment variables. Copy to .env.local and fill in.
# NEVER commit real secrets.
# ---------------------------------------------------------------

# Public site URL (used for SEO, sitemap, payment return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database.
# Empty or "pglite:./storage/pgdata" -> embedded PostgreSQL (PGlite) for local development.
# Production: a real PostgreSQL connection string, e.g.
# DATABASE_URL=postgres://user:password@host:5432/gulzor?sslmode=require
DATABASE_URL=

# Where uploaded images (product photos, inspiration images) are stored.
UPLOAD_DIR=./storage/uploads

# --- Telegram owner notifications (server-side only) ---
# Create a bot with @BotFather, then get the chat id of the owner/group.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Payme (Paycom) Merchant API ---
# Only enable after you have a merchant account and have passed Payme's sandbox tests.
PAYME_MERCHANT_ID=
PAYME_KEY=
# Use https://test.paycom.uz for sandbox, https://checkout.paycom.uz for production
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# --- Click SHOP API ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# --- Android app (Trusted Web Activity built with Bubblewrap) ---
# Served at /.well-known/assetlinks.json so the app opens without a browser address bar.
# Leave empty until the app exists (the URL then returns 404). See docs/ANDROID-ILOVA.md.
TWA_PACKAGE_NAME=
# SHA-256 certificate fingerprints, comma-separated (your upload key + Google Play's app signing key).
TWA_SHA256_FINGERPRINTS=

# --- E-mail order notifications (optional second channel, server-side only) ---
# Any SMTP mailbox works (e.g. Gmail with an app password, Yandex, Mail.ru, your hosting's mail).
# Orders are always saved first; a failed e-mail is logged on the order and can be resent in admin.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where new-order e-mails go (comma-separated for several addresses)
ORDER_EMAIL_TO=

# --- Telegram Mini App (shop bot that customers use; see docs/TELEGRAM-MINI-APP.md) ---
# Token of the customer-facing shop bot. Leave empty to use TELEGRAM_BOT_TOKEN for both.
TELEGRAM_SHOP_BOT_TOKEN=
# Optional: the bot's @username for florist "Connect Telegram" links (otherwise asked from Telegram once).
TELEGRAM_SHOP_BOT_USERNAME=
# Random secret (16+ chars) that Telegram sends with every webhook call. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
